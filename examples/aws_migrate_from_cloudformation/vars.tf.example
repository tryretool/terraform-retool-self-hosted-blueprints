# Copy this file to terraform.tfvars and fill it in.
#
#   cp vars.tf.example terraform.tfvars
#
# Every value marked "CloudFormation: X" is parameter or resource X of your
# existing stack. To list your stack's parameters:
#
#   aws cloudformation describe-stacks --stack-name <name> \
#     --query 'Stacks[0].Parameters' --output table
#
# See variables.tf for the full description of each input.

# ---------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------

# Keep this distinct from your CloudFormation stack name — both deployments run
# side by side until you cut over.
prefix      = "retool-prod"
region      = "us-west-2"
aws_profile = "retool"

tags = {
  environment = "production"
}

# CloudFormation: BaseDomain, without the scheme.
domain_name = "retool.example.com"

# ---------------------------------------------------------------------------
# Existing network — CloudFormation: VpcId, SubnetId, LoadBalancerSubnetId
# ---------------------------------------------------------------------------

vpc_id = "vpc-0123456789abcdef0"

# Must span >= 2 AZs and have outbound internet access so nodes can pull images.
# If your CloudFormation stack ran its tasks in public subnets with
# AssignPublicIp, prefer private subnets with a NAT gateway here.
private_subnet_ids = [
  "subnet-0123456789abcdef0",
  "subnet-0123456789abcdef1",
]

public_subnet_ids = [
  "subnet-0123456789abcdef0",
  "subnet-0123456789abcdef1",
]

# ---------------------------------------------------------------------------
# Existing database — CloudFormation: RetoolRDSInstance, RetoolRDSSecret
# ---------------------------------------------------------------------------
#
# This instance holds all your data. It is read, never recreated.

db = {
  instance_identifier   = "retool-prod-db"
  credentials_secret_id = "arn:aws:secretsmanager:us-west-2:012345678901:secret:RetoolRDSSecret-AbCdEf"

  # CloudFormation's GenerateSecretString nests the password under this key.
  password_property = "password"

  # Security group on the instance. This stack adds an ingress rule allowing
  # Postgres from the new EKS nodes; existing rules are left alone, so the
  # CloudFormation deployment keeps working throughout the migration.
  security_group_id = "sg-0123456789abcdef0"
}

# ---------------------------------------------------------------------------
# Existing secrets
# ---------------------------------------------------------------------------

# CloudFormation: RetoolEncryptionKeySecret.
#
# CARRY THIS OVER. Credentials stored in the Retool database are encrypted with
# this key; a new one makes every saved resource credential undecryptable.
encryption_key_secret = {
  secret_id = "arn:aws:secretsmanager:us-west-2:012345678901:secret:RetoolEncryptionKeySecret-AbCdEf"
  property  = "password"
}

# CloudFormation: RetoolJWTSecret. Carrying it over keeps users signed in across
# the cutover. Omit to generate a new one (everyone is signed out).
jwt_secret = {
  secret_id = "arn:aws:secretsmanager:us-west-2:012345678901:secret:RetoolJWTSecret-AbCdEf"
  property  = "password"
}

# CloudFormation: LicenseKeyARN, whose value is JSON keyed on "licenseKey".
license_key_secret = {
  secret_id = "arn:aws:secretsmanager:us-west-2:012345678901:secret:licenseKey-AbCdEf"
  property  = "licenseKey"
}

# ---------------------------------------------------------------------------
# Ingress — CloudFormation: CertificateARN
# ---------------------------------------------------------------------------

# Reuse the certificate your CloudFormation stack serves. Supplying it means
# this stack mints no certificate and creates no Route53 zone.
acm_certificate_arn = "arn:aws:acm:us-west-2:012345678901:certificate/00000000-1111-2222-3333-444444444444"

# Set only if you want this stack to manage the alias records for domain_name in
# a Route53 zone you already own. Leave unset when DNS is managed elsewhere —
# you then point domain_name at the alb_dns_name output yourself.
# hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# Edge authentication at the load balancer — CloudFormation: ALBListener2's
# authenticate-oidc action, AlbOAuthARN, FederateEnvironment.
#
# Omit entirely to serve Retool directly and rely on Retool's own authentication.
# Terraform reads credentials_secret_id, so its value lands in Terraform state:
# use an encrypted, access-restricted backend.
#
# alb_oidc = {
#   issuer                 = "https://idp-integ.federate.amazon.com"
#   authorization_endpoint = "https://idp-integ.federate.amazon.com/api/oauth2/v1/authorize"
#   token_endpoint         = "https://idp-integ.federate.amazon.com/api/oauth2/v2/token"
#   user_info_endpoint     = "https://idp-integ.federate.amazon.com/api/oauth2/v1/userinfo"
#   credentials_secret_id  = "arn:aws:secretsmanager:us-west-2:012345678901:secret:alb-oauth-AbCdEf"
#   client_id_property     = "clientId"
#   client_secret_property = "clientSecret"
# }

# ---------------------------------------------------------------------------
# Temporal — CloudFormation: RetoolTemporalRDSCluster, RetoolTemporalRDSSecret
# ---------------------------------------------------------------------------
#
# Required for Retool Workflows. The Helm chart runs the Temporal cluster itself,
# so only the database is carried over. Omit to run Retool without Workflows.

temporal = {
  host                  = "retool-temporal.cluster-abcdefghij.us-west-2.rds.amazonaws.com"
  port                  = 5432
  username              = "retool"
  credentials_secret_id = "arn:aws:secretsmanager:us-west-2:012345678901:secret:RetoolTemporalRDSSecret-AbCdEf"
  password_property     = "password"
  security_group_id     = "sg-0123456789abcdef0"

  # CloudFormation: TemporalImage.
  image_repository = "tryretool/one-offs"
  image_tag        = "retool-temporal-1.1.6"

  # The Temporal Web UI, reachable via `kubectl port-forward`.
  enable_web_ui = false
}

# ---------------------------------------------------------------------------
# CloudAuth (Amazon-internal only)
# ---------------------------------------------------------------------------
#
# Omit unless you are migrating an Amazon-internal deployment. Values come from
# the CloudFormation stack's Mappings block.
#
# cloudauth = {
#   vpc_endpoint_service_name = "com.amazonaws.vpce.us-west-2.vpce-svc-0000000000000000"
#   fqen                      = "/svc1/CloudAuth/prod/us-west-2"
#   subdomain                 = "oauth.cloudauth.a2z.com"
#   api_gateway_account_ids   = ["012345678901"]
# }

# ---------------------------------------------------------------------------
# Retool application
# ---------------------------------------------------------------------------

# CloudFormation: RetoolImage, tag only. Match what you run today so the
# migration changes one thing at a time; upgrade afterwards.
retool_image_tag = "4.0.9-stable"

# CloudFormation: DesiredCount, DesiredWorkflowsCount, DesiredCodeExecutorCount.
replica_counts = {
  backend           = 2
  workflows_backend = 3
  workflows_worker  = 3
  code_executor     = 2
}

# CloudFormation: UsageAPIToken. Rendered as a plain Helm value, so it is stored
# in Terraform state. To avoid that, omit it and add USAGE_API_TOKEN to the
# retool/<prefix>/extra-env-vars secret after the first apply.
# usage_api_token = "..."

# CloudFormation: LDAPRoleMapping.
# ldap_role_mapping = "GRS-Tech-Admin->admin"
