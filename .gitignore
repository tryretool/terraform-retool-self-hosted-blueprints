# Local .terraform directories
**/.terraform/*

# Shared provider cache used by `make validate`
.terraform-plugin-cache/

# Terraform lockfile
.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Exclude all .tfvars files, which are likely to contain sentitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars

# values.yaml
kubeconfig
provider.tf
backend.tf
*.pem
*.key

.DS_Store
.vscode/
/tmp

# Python
__pycache__/
*.py[cod]
# Local virtualenv, only to give an editor/LSP importable copies of
# scripts/autoupdate.py's dependencies; uv resolves the real ones itself.
.venv/

*.log
*.tgz
*.lock

**/certs/**

# Ephemeral per-deployment directories (state, providers, etc.)
deployments/

# Temp files from an interrupted scripts/autoupdate.py run.
.*.autoupdate
